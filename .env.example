# App
NEXT_PUBLIC_APP_NAME=StreamTrust
NODE_ENV=development

# Database
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# AI (ADR-0008: nim primary, gemini alt, mock for tests/CI)
# Until the NIM pre-flight check lands nim-provider.ts, use mock locally.
AI_PROVIDER=mock
# NIM model candidates from ADR-0008 (exact vendor-prefixed slug to be
# confirmed in pre-flight before use — do not guess):
# nemotron-3-nano-omni-30b-a3b-reasoning (function-calling primary)
# llama-3.2-11b-vision-instruct (prompt-JSON fallback)
# Gemini alt model (live-verified 2026-09-30; 2.5-flash 404s for new keys):
# gemini-3.8-flash
AI_MODEL=
NIM_API_KEY=
GEMINI_API_KEY=

# FHIR
FHIR_BASE_URL=http://localhost:3000/fhir
FHIR_VALIDATION_BASE_URL=https://hapi.fhir.org/baseR4
FHIR_PUSH_ENABLED=false
FHIR_PUSH_BASE_URL=

# Security
VOLUNTEER_COOKIE_SECRET=
RATE_LIMIT_SUGGEST_PER_HOUR=10
